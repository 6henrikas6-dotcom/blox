{
  "name": "blox-devguard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "commands": "tsx src/deploy.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node scripts/repair-migrations.mjs && prisma migrate deploy",
    "db:generate": "prisma generate",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "discord.js": "^14.22.1",
    "dotenv": "^16.6.1",
    "pino": "^9.12.0",
    "sharp": "^0.34.5",
    "opentype.js": "^1.3.4",
    "@fontsource/noto-sans": "^5.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/opentype.js": "^1.3.8",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
