generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model GuildConfig {
  guildId String @id
  logChannelId String?
  announcementChannelId String?
  verifiedRoleId String?
  joinThreshold Int @default(8)
  lockdown Boolean @default(false)
  updatedAt DateTime @updatedAt
}
model Subscription {
  guildId String
  userId String
  enabled Boolean @default(true)
  updatedAt DateTime @updatedAt
  @@id([guildId, userId])
}
model ModerationCase {
  id String @id @default(cuid())
  guildId String
  targetId String
  actorId String
  action String
  reason String?
  createdAt DateTime @default(now())
  @@index([guildId, targetId])
}
model AuditEvent {
  id String @id @default(cuid())
  guildId String
  actorId String?
  event String
  detail String?
  createdAt DateTime @default(now())
  @@index([guildId, createdAt])
}
model Xp {
  guildId String
  userId String
  points Int @default(0)
  lastEarnedAt DateTime @default(now())
  @@id([guildId, userId])
}

model LockdownOverwrite {
  guildId String
  channelId String
  previous String
  @@id([guildId, channelId])
}

model CommunityPanel {
  guildId String @id
  verifyChannelId String?
  verifiedRoleId String?
  verifyMessage String @default("Paspausk Verify, kad gautum prieigą prie serverio.")
  ticketChannelId String?
  ticketCategoryId String?
  supportRoleId String?
  ticketMessage String @default("Reikia pagalbos? Atidaryk ticketą.")
  updatedAt DateTime @updatedAt
}
model SupportTicket {
  id String @id @default(cuid())
  guildId String
  userId String
  channelId String @unique
  status String @default("open")
  createdAt DateTime @default(now())
  closedAt DateTime?
  @@index([guildId,userId,status])
}

model Giveaway {
 id String @id @default(cuid())
 guildId String
 channelId String
 messageId String @unique
 prize String
 winnerCount Int @default(1)
 endsAt DateTime
 ended Boolean @default(false)
 createdAt DateTime @default(now())
 @@index([guildId,ended,endsAt])
}
model GiveawayEntry {
 giveawayId String
 userId String
 @@id([giveawayId,userId])
}
