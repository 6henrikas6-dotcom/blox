generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model GuildConfig {
  guildId String @id
  logChannelId String?
  announcementChannelId String?
  suggestionChannelId String?
  verifiedRoleId String?
  joinThreshold Int @default(8)
  lockdown Boolean @default(false)
  updatedAt DateTime @updatedAt
}
model Subscription {
  guildId String
  userId String
  enabled Boolean @default(true)
  updatedAt DateTime @updatedAt
  @@id([guildId, userId])
}
model ModerationCase {
  id String @id @default(cuid())
  guildId String
  targetId String
  actorId String
  action String
  reason String?
  createdAt DateTime @default(now())
  @@index([guildId, targetId])
}
model AuditEvent {
  id String @id @default(cuid())
  guildId String
  actorId String?
  event String
  detail String?
  createdAt DateTime @default(now())
  @@index([guildId, createdAt])
}
model Xp {
  guildId String
  userId String
  points Int @default(0)
  lastEarnedAt DateTime @default(now())
  @@id([guildId, userId])
}

model LockdownOverwrite {
  guildId String
  channelId String
  previous String
  @@id([guildId, channelId])
}

model CommunityPanel {
  guildId String @id
  verifyChannelId String?
  verifiedRoleId String?
  verifyMessage String @default("Paspausk Verify, kad gautum prieigą prie serverio.")
  ticketChannelId String?
  ticketCategoryId String?
  supportRoleId String?
  ticketMessage String @default("Reikia pagalbos? Atidaryk ticketą.")
  ticketOptionsJson String?
  feedbackChannelId String?
  updatedAt DateTime @updatedAt
}
model SupportTicket {
  id String @id @default(cuid())
  guildId String
  userId String
  channelId String @unique
  status String @default("open")
  createdAt DateTime @default(now())
  closedAt DateTime?
  closedById String?
  claimedById String?
  transcriptText String?
  feedbackRating Int?
  feedbackAt DateTime?
  @@index([guildId,userId,status])
}

model Giveaway {
 id String @id @default(cuid())
 guildId String
 channelId String
 messageId String @unique
 prize String
 winnerCount Int @default(1)
 endsAt DateTime
 ended Boolean @default(false)
 createdAt DateTime @default(now())
 @@index([guildId,ended,endsAt])
}
model GiveawayEntry {
 giveawayId String
 userId String
 @@id([giveawayId,userId])
}

model CommunityAutomation {
 guildId String @id
 welcomeChannelId String?
 goodbyeChannelId String?
 inviteLogChannelId String?
 levelChannelId String?
 welcomeMessage String @default("👋 Sveikas atvykęs, {user}! Tu esi {count}-asis narys.")
 goodbyeMessage String @default("👋 {username} paliko serverį.")
 levelMessage String @default("🎉 {user} pasiekė {level} lygį!")
 xpEnabled Boolean @default(true)
 xpPerMessage Int @default(5)
 xpCooldownSeconds Int @default(60)
 levelUpEnabled Boolean @default(true)
 inviteTrackingEnabled Boolean @default(true)
 updatedAt DateTime @updatedAt
}
model MemberInvite {
 guildId String
 userId String
 inviterId String?
 inviteCode String?
 joinedAt DateTime @default(now())
 @@id([guildId,userId])
 @@index([guildId,inviterId])
}

// Digital fulfilment: files are private PostgreSQL bytea values, never public URLs.
model DigitalOrder {
 id String @id @default(cuid())
 guildId String
 orderNumber String
 buyerId String?
 productName String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 items DigitalOrderItem[]
 @@unique([guildId,orderNumber])
 @@index([guildId,buyerId])
}
model DigitalOrderItem {
 id String @id @default(cuid())
 orderId String
 productNumber String
 productName String
 fileName String?
 fileMime String?
 fileData Bytes?
 deliveryState String @default("pending")
 preparationStatus String @default("preparing")
 deliveredTo String?
 deliveredAt DateTime?
 createdAt DateTime @default(now())
 order DigitalOrder @relation(fields:[orderId],references:[id],onDelete:Cascade)
 @@unique([orderId,productNumber])
}
